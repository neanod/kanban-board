# =================================================================
# Kanban Task Board Configuration
# Copy this file to .env and fill in your values
# =================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8092
BASE_URL=https://your-domain.com:8445

# Telegram Bot Credentials (obtain from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Web Interface Access Password
WEB_PASSWORD=your_secure_password_here

# Primary Administrator Telegram ID (grants exclusive access to bot settings)
ADMIN_TG_ID=123456789

# Authorized Users Mapping in JSON format: {"TelegramID": "username"}
TG_USER_MAP={"123456789": "nikita", "987654321": "dmitry", "112233445": "andrii"}

# Database Path (optional, defaults to data/kanban.db)
# DB_PATH=data/kanban.db
